//
//  Config.xcconfig
//  wwWallet
//
//  Created by Benjamin Erhart on 12.05.25.
//

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// Avoid accidental checkins:
// git update-index --skip-worktree Config.xcconfig
// git update-index --no-skip-worktree Config.xcconfig

APP_BUNDLE_ID[config=Debug] = org.wwwallet.wwwallet
EAF_BUNDLE_ID[config=Debug] = org.wwwallet.wwwallet.autofill
APP_GROUP[config=Debug] = group.org.wwwallet.wwwallet
DEVELOPMENT_TEAM[config=Debug] =
CODE_SIGN_IDENTITY[config=Debug] = iPhone Developer
APP_PROVISIONING_PROFILE_SPECIFIER[config=Debug] =
EAF_PROVISIONING_PROFILE_SPECIFIER[config=Debug] =
BASE_DOMAIN1[config=Debug] = demo.wwwallet.org
BASE_DOMAIN2[config=Debug] = demo.wwwallet.org
BASE_DOMAIN3[config=Debug] =
BASE_DOMAIN4[config=Debug] =
BASE_DOMAIN5[config=Debug] =

APP_BUNDLE_ID[config=Release] =
EAF_BUNDLE_ID[config=Release] =
APP_GROUP[config=Release] =
DEVELOPMENT_TEAM[config=Release] =
CODE_SIGN_IDENTITY[config=Release] =
APP_PROVISIONING_PROFILE_SPECIFIER[config=Release] =
EAF_PROVISIONING_PROFILE_SPECIFIER[config=Release] =
BASE_DOMAIN1[config=Release] =
BASE_DOMAIN2[config=Release] =
BASE_DOMAIN3[config=Release] =
BASE_DOMAIN4[config=Release] =
BASE_DOMAIN5[config=Release] =

// Optional FaceTec support.
//
// To enable:
// 1. Run Vendor/FaceTecSDK/fetch.sh (Read script comments for instructions on how to provide Github PAT!)
// 2. Uncomment APP_OTHER_LDFLAGS below.
// 3. Add FACETEC_API_BASE_URL and FACETEC_API_BEARER_TOKEN below.
//
// NOTE: You will need to use the SIROS ID BUNDLE_IDs for this to work in development and in production!
// (Or you get your own FaceTecSDK access.)
//
FRAMEWORK_SEARCH_PATHS = "$(PROJECT_DIR)/Vendor/FaceTecSDK/Frameworks/FaceTecSDK.xcframework/ios-arm64" "$(PROJECT_DIR)/Vendor/FaceTecSDK/Frameworks/FaceTecSDK.xcframework/ios-arm64_x86_64-simulator"
APP_OTHER_LDFLAGS = //-framework FaceTecSDK
FACETEC_API_BASE_URL =
FACETEC_API_BEARER_TOKEN =

MARKETING_VERSION = 0.1.3
CURRENT_PROJECT_VERSION = 31

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) APP_GROUP="$(APP_GROUP)" BASE_DOMAIN1="$(BASE_DOMAIN1)" BASE_DOMAIN2="$(BASE_DOMAIN2)" BASE_DOMAIN3="$(BASE_DOMAIN3)" BASE_DOMAIN4="$(BASE_DOMAIN4)" BASE_DOMAIN5="$(BASE_DOMAIN5)" FACETEC_API_BASE_URL="$(FACETEC_API_BASE_URL)" FACETEC_API_BEARER_TOKEN="$(FACETEC_API_BEARER_TOKEN)"


SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG ALLOW_DOMAIN_SWITCHING
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release] =
