        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiakirjan tietoja ei voitu lukea, joten todistusta ei myönnetty. Yritä uudelleen tai käytä toista henkilöllisyysasiakirjaa."
