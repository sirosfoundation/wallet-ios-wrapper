    "The provided PIN is invalid." : {
      "comment" : "Error message when the provided PIN is invalid.",
      "isCommentAutoGenerated" : true
    },
    "The security key can have several passkeys on it. Please choose which passkey you would like to log in with." : {
      "comment" : "A description of the credential selection screen.",
      "isCommentAutoGenerated" : true
    },
    "This device cannot read NFC. Reading the chip in your passport or ID card is required, so identity verification is not possible on this device." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν μπορεί να διαβάσει NFC. Απαιτείται ανάγνωση του τσιπ του διαβατηρίου ή της ταυτότητάς σας, επομένως η επαλήθευση ταυτότητας δεν είναι δυνατή σε αυτή τη συσκευή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite ei pysty lukemaan NFC:tä. Passin tai henkilökortin sirun lukeminen on pakollista, joten henkilöllisyyttä ei voi vahvistaa tällä laitteella."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue ler NFC. É necessário ler o chip do seu passaporte ou cartão de identificação, pelo que não é possível verificar a identidade neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte läsa NFC. Chippet i ditt pass eller id-kort måste läsas, så identitetsverifiering är inte möjlig på den här enheten."
          }
        }
      }
    },
    "This device could not read the chip. Please try again." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συσκευή δεν μπόρεσε να διαβάσει το τσιπ. Δοκιμάστε ξανά."
