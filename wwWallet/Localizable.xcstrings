    },
    "Please remember your PIN, as you will need it to unlock your security key. This PIN is unique to this specific key and is separate from your main wallet account. Only you know the PIN. We can not help you reset the pin if you forget it." : {
      "comment" : "A description of the PIN.",
      "isCommentAutoGenerated" : true
    },
    "Reading the chip in your document is required. Please try again and hold your document against the top of the phone when asked." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται ανάγνωση του τσιπ του εγγράφου σας. Δοκιμάστε ξανά και κρατήστε το έγγραφο στο επάνω μέρος του τηλεφώνου όταν σας ζητηθεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiakirjan sirun lukeminen on pakollista. Yritä uudelleen ja pidä asiakirjaa puhelimen yläreunaa vasten, kun sitä pyydetään."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário ler o chip do seu documento. Tente novamente e encoste o documento à parte de cima do telemóvel quando lhe for pedido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chippet i ditt dokument måste läsas. Försök igen och håll dokumentet mot telefonens överkant när du blir ombedd."
          }
        }
      }
    },
    "Select Passkey to Use" : {
      "comment" : "Title of a view that allows the user to select a passkey from a list.",
      "isCommentAutoGenerated" : true
    },
    "Something went wrong on our side, so no credential was issued. Please try again later." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρουσιάστηκε σφάλμα από την πλευρά μας, επομένως δεν εκδόθηκε πιστοποιητικό. Δοκιμάστε ξανά αργότερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meillä tapahtui virhe, joten todistusta ei myönnetty. Yritä myöhemmin uudelleen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro do nosso lado, pelo que não foi emitida nenhuma credencial. Tente novamente mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel hos oss, så inget intyg utfärdades. Försök igen senare."
          }
        }
      }
    },
    "The chip in your document could not be confirmed as issued by a recognised authority, so no credential was issued." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό να επιβεβαιωθεί ότι το τσιπ του εγγράφου σας έχει εκδοθεί από αναγνωρισμένη αρχή, επομένως δεν εκδόθηκε πιστοποιητικό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voitu varmistaa, että asiakirjasi sirun on myöntänyt tunnustettu viranomainen, joten todistusta ei myönnetty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar que o chip do seu documento foi emitido por uma autoridade reconhecida, pelo que não foi emitida nenhuma credencial."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att bekräfta att chippet i ditt dokument har utfärdats av en erkänd myndighet, så inget intyg utfärdades."
          }
        }
      }
    },
    "The chip in your document could not be read. Please try again and hold the document still against the top of the phone." : {
