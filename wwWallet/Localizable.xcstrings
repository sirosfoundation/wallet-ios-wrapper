        }
      }
    },
    "This document cannot be verified by its chip. Please use an e-passport or an ID card whose chip can be read." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το έγγραφο δεν μπορεί να επαληθευτεί μέσω του τσιπ του. Χρησιμοποιήστε ηλεκτρονικό διαβατήριο ή ταυτότητα της οποίας το τσιπ μπορεί να διαβαστεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä asiakirjaa ei voi vahvistaa sen sirun avulla. Käytä sähköistä passia tai henkilökorttia, jonka siru voidaan lukea."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este documento não pode ser verificado através do chip. Utilize um passaporte eletrónico ou um cartão de identificação cujo chip possa ser lido."
          }
        },
        "sv" : {
          "stringUnit" : {
