    "Touch the key where it is blinking to confirm you are present." : {
      "comment" : "A description of the touch gesture for the security key.",
      "isCommentAutoGenerated" : true
    },
    "Touch Your Security Key" : {
      "comment" : "Title of a view that instructs the user to touch their security key.",
      "isCommentAutoGenerated" : true
    },
    "We could not confirm that a live person was in front of the camera, so no credential was issued. Please try again in good light, facing the camera." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό να επιβεβαιωθεί ότι μπροστά στην κάμερα βρισκόταν ζωντανό πρόσωπο, επομένως δεν εκδόθηκε πιστοποιητικό. Δοκιμάστε ξανά με καλό φωτισμό, κοιτάζοντας την κάμερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme voineet varmistaa, että kameran edessä oli elävä henkilö, joten todistusta ei myönnetty. Yritä uudelleen hyvässä valaistuksessa kameraan katsoen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar que estava uma pessoa real em frente à câmara, pelo que não foi emitida nenhuma credencial. Tente novamente com boa iluminação, de frente para a câmara."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte bekräfta att en levande person fanns framför kameran, så inget intyg utfärdades. Försök igen i bra ljus och titta mot kameran."
          }
        }
      }
    },
    "Your face did not match the photo stored in your document's chip, so no credential was issued. Please try again, or use another identity document." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρόσωπό σας δεν ταίριαξε με τη φωτογραφία που είναι αποθηκευμένη στο τσιπ του εγγράφου σας, επομένως δεν εκδόθηκε πιστοποιητικό. Δοκιμάστε ξανά ή χρησιμοποιήστε άλλο έγγραφο ταυτότητας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasvosi eivät vastanneet asiakirjasi siruun tallennettua kuvaa, joten todistusta ei myönnetty. Yritä uudelleen tai käytä toista henkilöllisyysasiakirjaa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu rosto não correspondeu à fotografia guardada no chip do seu documento, pelo que não foi emitida nenhuma credencial. Tente novamente ou utilize outro documento de identificação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt ansikte stämde inte med fotot som är lagrat i dokumentets chip, så inget intyg utfärdades. Försök igen eller använd en annan identitetshandling."
          }
        }
      }
    },
    "Your identity could not be verified, so no credential was issued. Please try again." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επαλήθευση της ταυτότητάς σας, επομένως δεν εκδόθηκε πιστοποιητικό. Δοκιμάστε ξανά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilöllisyyttäsi ei voitu vahvistaa, joten todistusta ei myönnetty. Yritä uudelleen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a sua identidade, pelo que não foi emitida nenhuma credencial. Tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din identitet kunde inte verifieras, så inget intyg utfärdades. Försök igen."
          }
        }
      }
    },
    "Your identity was verified, but the credential could not be issued. Please try again later." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταυτότητά σας επαληθεύτηκε, αλλά δεν ήταν δυνατή η έκδοση του πιστοποιητικού. Δοκιμάστε ξανά αργότερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henkilöllisyytesi vahvistettiin, mutta todistusta ei voitu myöntää. Yritä myöhemmin uudelleen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua identidade foi verificada, mas não foi possível emitir a credencial. Tente novamente mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din identitet har verifierats, men intyget kunde inte utfärdas. Försök igen senare."
          }
        }
      }
    },
    "Your scan could not be accepted: your face did not match the document photo closely enough, or this type of document is not accepted. Please try again in good light, or use another identity document." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σάρωσή σας δεν έγινε αποδεκτή: το πρόσωπό σας δεν ταίριαξε αρκετά με τη φωτογραφία του εγγράφου ή αυτός ο τύπος εγγράφου δεν γίνεται αποδεκτός. Δοκιμάστε ξανά με καλό φωτισμό ή χρησιμοποιήστε άλλο έγγραφο ταυτότητας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaustasi ei voitu hyväksyä: kasvosi eivät vastanneet asiakirjan kuvaa riittävän hyvin, tai tämäntyyppistä asiakirjaa ei hyväksytä. Yritä uudelleen hyvässä valaistuksessa tai käytä toista henkilöllisyysasiakirjaa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua digitalização não pôde ser aceite: o seu rosto não correspondeu suficientemente à fotografia do documento, ou este tipo de documento não é aceite. Tente novamente com boa iluminação ou utilize outro documento de identificação."
          }
        },
        "sv" : {
          "stringUnit" : {
